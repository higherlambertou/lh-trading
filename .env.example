# Shioaji 帳號 (從永豐金 API 申請頁取得)
SHIOAJI_API_KEY=your_api_key_here
SHIOAJI_SECRET_KEY=your_secret_key_here

# CA 憑證（下單必須，純查報價可不填）
CA_PATH=/path/to/your_cert.pfx
CA_PASSWORD=your_ca_password
PERSON_ID=your_national_id

# simulation=true 為模擬模式（不會真實下單）
# 確認策略正確後改為 false 才會送到交易所（真錢！）
SIMULATION=true

# 正式啟動設 false（避免 uvicorn reload 干擾）
DEV=false

# ── 多機部署 ──────────────────────────────────────────────
# 正式盤後端綁定的 IP 與 port（main.py 使用）。
# 每台機器填自己的 IP（例如 Tailscale IP）。run_live.sh 的健康檢查也讀 BIND_HOST，
# 沒設則 fallback localhost。模擬盤固定綁 0.0.0.0:8003，不受這兩個影響。
BIND_HOST=localhost
PORT=8002

# 允許的前端來源，逗號分隔（CORS）
CORS_ORIGINS=http://localhost:3002

# 登入硬性逾時秒數（Solace 卡死時用，預設 25）
LOGIN_TIMEOUT=25

# ── 市場狀態判斷（Hurst + IV；見 CLAUDE.md「市場狀態判斷」）─────────────
# 以下全部可不填，括號內為預設值
# HURST_WINDOW=60            # 用最近幾根日K算 Hurst（60 根的 H 雜訊約 ±0.13；250 根約 ±0.06）
# HURST_TREND_TH=0.55        # H 高於此值 → 趨勢
# HURST_REVERT_TH=0.45       # H 低於此值 → 均值回歸
# HURST_MIN_Z=0              # >0 時，|z| 不足一律視為「隨機漫步」（想保守可設 1.0）
# IV_AUTO=true               # 自動向券商抓 ATM IV（手動輸入永遠優先）
# IV_MIN_HISTORY=60          # IV 歷史少於此天數 → IV 層顯示「累積中」，只依 Hurst 判斷
# IV_REQUIRED=false          # true：IV 層未就緒時一律判「不明確」
# IV_MIN_DAYS=7              # 自動抓 IV 只選距到期 >= 此天數的 TXO 月份
# IV_RATE=0.015              # Black-76 無風險利率
# MARKET_STATE_TIME=0830     # 每日盤前計算時間 HHMM
# MARKET_STATE_POST_TIME=1350  # 每日盤後更新時間 HHMM
# MARKET_STATE_GATE=warn     # warn=啟動與今日狀態不符的策略時警告（不擋）；off=關閉

# ── 成交紀錄（data/trade_log.db）─────────────────────────────
# TRADE_LOG=true             # false 可整個關掉（所有 hook 變 no-op，下單行為完全不變）
