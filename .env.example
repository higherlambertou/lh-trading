# Shioaji 帳號 (從永豐金 API 申請頁取得)
SHIOAJI_API_KEY=your_api_key_here
SHIOAJI_SECRET_KEY=your_secret_key_here

# CA 憑證（下單必須，純查報價可不填）
CA_PATH=/path/to/your_cert.pfx
CA_PASSWORD=your_ca_password
PERSON_ID=your_national_id

# simulation=true 為模擬模式（不會真實下單）
# 確認策略正確後改為 false 才會送到交易所（真錢！）
SIMULATION=true

# 正式啟動設 false（避免 uvicorn reload 干擾）
DEV=false

# ── 多機部署 ──────────────────────────────────────────────
# 正式盤後端綁定的 IP 與 port（main.py 使用）。
# 每台機器填自己的 IP（例如 Tailscale IP）。run_live.sh 的健康檢查也讀 BIND_HOST，
# 沒設則 fallback localhost。模擬盤綁 SIM_BIND_HOST；沒設就跟著 BIND_HOST，再沒有就 127.0.0.1（8003，不再是 0.0.0.0）。
# SIM_BIND_HOST=               # 模擬盤要綁的位址（選填）；不要設 0.0.0.0（後端沒有身分驗證）
BIND_HOST=localhost
PORT=8002

# 允許的前端來源，逗號分隔（CORS）
CORS_ORIGINS=http://localhost:3002

# 登入硬性逾時秒數（Solace 卡死時用，預設 25）
LOGIN_TIMEOUT=25

# ── 市場狀態判斷（Hurst + IV；見 CLAUDE.md「市場狀態判斷」）─────────────
# 以下全部可不填，括號內為預設值
# HURST_WINDOW=60            # （HURST_FREQ=D 時）用最近幾根日K算 Hurst（60 根的 H 雜訊約 ±0.13；250 根約 ±0.06）
# HURST_FREQ=D               # D=日K 60 根（現行）；5m=5分K 近 N 日（日間穩定約 10 倍，見 update.md 發現 6）
# HURST_DAYS=20              # （HURST_FREQ=5m 時）用最近幾個交易日的 5 分K
# HURST_TREND_TH=0.55        # H 高於此值 → 趨勢
# HURST_REVERT_TH=0.45       # H 低於此值 → 均值回歸
# HURST_MIN_Z=0              # >0 時，|z| 不足一律視為「隨機漫步」（想保守可設 1.0）
# IV_AUTO=true               # 自動向券商抓 ATM IV（手動輸入永遠優先）
# IV_MIN_HISTORY=60          # IV 歷史少於此天數 → IV 層顯示「累積中」，只依 Hurst 判斷
# IV_REQUIRED=false          # true：IV 層未就緒時一律判「不明確」
# IV_MIN_DAYS=7              # 自動抓 IV 只選距到期 >= 此天數的 TXO 月份
# IV_RATE=0.015              # Black-76 無風險利率
# MARKET_STATE_TIME=0830     # 每日盤前計算時間 HHMM
# MARKET_STATE_POST_TIME=1350  # 每日盤後更新時間 HHMM
# MARKET_STATE_GATE=warn     # warn=啟動與今日狀態不符的策略時警告（不擋）；off=關閉
# BACKUP=true                # 每個交易日自動備份 market_state.db / trade_log.db（IV 歷史、日誌、成交紀錄無法重建）
# BACKUP_TIME=1400           # 備份時間 HHMM
# BACKUP_KEEP_DAYS=14        # 保留最近幾天的備份
# BACKUP_DIR=                # 備份位置（預設 data/backup；建議指到另一顆硬碟或雲端同步資料夾）
# RECORD_QUOTE_UPDATES=false # true = 連「報價更新」（沒資訊量的事件，約占 77%）也存進 ticks.db
# TICK_STRATEGIES_TMF_ONLY=true # ma_cross／breakout／rsi／bollinger／momentum 只吃 TMF 行情（三合約交錯會讓訊號一直被誤觸）；false = 恢復舊行為
# RECORD_BOOK=true           # ticks.db 的成交列另存「成交之後」的盤口摘要（第一檔、五檔總量、交易所累計內外盤、均價、現貨）；false = 這些欄位留空（update.md 發現 28）
# RECORD_FLOW=true           # 每分鐘彙總 TMF 外/內盤成交存進 market_state.db（flow_1m；市場指標視覺化要驗證所需的歷史）
# STOP_POSITION_CHECK=true   # 停止策略前，除了策略自己記的部位，也向券商確認帳上的 TMF 部位（有就擋下，?force=true 才停）；false = 只看策略自己記的
# ENTRY_POSITION_CHECK=true  # scalp 進場前向券商確認 TMF 部位與未成交委託（max_qty 是持倉上限）；false = 恢復舊行為，只看策略自己記的部位
# RISK_DAY_START=1500        # 策略風控「當日」的換日時間 HHMM（當日最大虧損、當日進場次數）；1500 = 夜盤開盤換日，0 = 日曆日（00:00）
# FILTER_PREOPEN_QUOTES=true  # 開盤前試算時段（08:30~08:45、14:50~15:00）的行情只顯示、不餵策略／K棒／即時狀態／落地；false = 恢復舊行為（試算價會污染指標）

# ── 持倉保護（update.md 發現 32）──────────────────────────────
# 手動停損停利監控落地與重啟後對帳恢復、凍結與重啟時推播到手機。需重啟後端；通知通道不設定就只有 log 與畫面橫幅
# MANUAL_WATCH_PERSIST=true   # false = 手動停損監控不落地（重啟就消失，舊行為）
# MANUAL_WATCH_STATE=         # 落地檔路徑；不設則 data/manual_watches_live.json（模擬盤 _sim）
# POSITION_STATE_FILE=true    # 後端每 5 秒把持倉寫進 data/position_state_<mode>.json，watchdog 凍結時靠它知道有沒有持倉
# 推播通道（可同時設多個；設好後用 python -m core.notify test 測試）。訊息只放合約、方向、口數與停損點數
# NOTIFY_TELEGRAM_TOKEN=      # Telegram bot token（@BotFather 建立）
# NOTIFY_TELEGRAM_CHAT_ID=    # 你的 chat id：先在 Telegram 對 bot 傳一則訊息，再跑 python -m core.notify chat-id
# NOTIFY_NTFY_URL=            # https://ntfy.sh/<主題>：主題名稱就是密碼，請用一長串隨機字（或自架 ntfy）
# NOTIFY_WEBHOOK_URL=         # 收 JSON {title, message, priority} 的任何網址
# NOTIFY_FILLS=manual         # 成交推播：manual＝只通知手動下的單（預設）、all＝連策略、off＝關閉（update.md 發現 34）
# NOTIFY_MARGIN_WARN=150      # 保證金風險：權益總值 ÷ 維持保證金 低於這個 %（警告）
# NOTIFY_MARGIN_URGENT=120    # 低於這個 %（緊急）；券商回報追繳一律緊急
# NOTIFY_SIM=false            # true＝模擬盤也推播（預設不推：模擬的成交與持倉不是真錢）

# ── 指標類通知（update.md 發現 37；只通知、不動委託）──────────────
# VOL_WATCH=true              # 波動放大提醒（空手也發；持倉中另帶離停損還有幾點）；false＝關閉
# VOL_ALERT_RATIO=2.0         # 最近 30 分鐘 σ ÷ 同時段近 20 個時段中位數 ≥ 這個倍數才通知（日盤描述統計：2×≈每個日盤 0.39 次、1.5×≈1.17 次、3×≈0.08 次）
# VOL_ALERT_COOLDOWN_MIN=10   # 波動放大：同一個時段內兩則通知至少隔幾分鐘（日盤歷史：10 分鐘≈平均 1.2 則／日盤、60 分鐘≈0.39 則）
# DAILY_BRIEF=true            # 盤前摘要；false＝關閉
# DAILY_BRIEF_TIME=0835       # 幾點發（HHMM）；到 09:30 之前都會補發，一天一則

# ── 順勢爆量訊號的影子模式（update.md 發現 43；只記錄與通知、不下單）──────
# SIGNAL_SHADOW=true           # 影子模式；false＝關閉
# SHADOW_NOTIFY=50            # 哪些變體通知：off 或逗號分隔的點數（30,40,50）；預設只有 50（日盤平均每個日盤約 2.6 則）
# SHADOW_COST_PTS=4           # 每筆來回成本（點），結果與歷史檢定都用它

# ── 換月（update.md 發現 38）────────────────────────────────────
# ROLLOVER_RESTART=true       # 近月合約結算後，要求 watchdog 重啟換到下個月合約（結算日 14:46／17:16、隔天 07:51／08:01 各試一次）；false＝關閉

# ── 建議停損停利（update.md 發現 33）─────────────────────────────
# SUGGEST_COST_PTS=4          # 每筆來回成本（點）：手續費＋稅＋滑價。預設 4 是假設，請改成自己的數字；卡片的「要多贏幾個百分點才打平」用它
# SUGGEST_RISK_PCT=1          # 單筆風險占權益的上限（%）；卡片的「最多幾口」用它

# ── 成交紀錄（data/trade_log.db）─────────────────────────────
# TRADE_LOG=true             # false 可整個關掉（所有 hook 變 no-op，下單行為完全不變）
#                            # 進場市場狀態紀錄（entry_snapshots／exit_fills）跟著它一起開關，沒有另外的開關

# ── 回測（分析分頁的〈策略回測〉面板，跑 python -m core.backtest 的子行程）──────────
# BACKTEST_API=true          # false = 整個關掉回測 API（面板會顯示無法使用）
# BACKTEST_WORKERS=2         # 回測最多開幾個平行行程（降低優先權跑；開越多越快，但越吃 CPU，會跟下單搶資源）
# BACKTEST_TIMEOUT_SEC=1800  # 單次回測的時間上限，超過就中止
# OPTION_SPREAD_LOG=true     # 盤中每 N 分鐘向券商查一次整條選擇權鏈、記買賣價差（data/option_spread.db；無法回補）。需重啟後端；false = 不記（update.md 發現 30）
# INTEL_DB=                    # 〈資訊〉分頁讀的 lh-intel 資料庫（唯讀）；沒設就用同一層的 ../lh-intel/data/intel.db（update.md 發現 49）
# OPTION_SPREAD_MINUTES=10   # 取樣間隔（分鐘）；每次取樣排進 worker 佇列查一次整條鏈，別設太短
# PREMARKET_LOG=true         # 盤前跨市場資訊紀錄（只記錄、不影響交易；trade_log.db 的 premarket_snapshots）。需重啟後端；false = 不記（update.md 發現 31）
# PREMARKET_TIME=08:30       # 取樣時間 T（台北時間；日盤 08:45 開盤前）。資料時間戳晚於 T 的一律拒絕
# PREMARKET_SOURCES=nasdaq,cboe   # 外部來源順序（逗號分隔）。Yahoo 對這台機器被 429 擋，要試就寫 yahoo,nasdaq,cboe（失敗自動換下一個）
# PREMARKET_RANGE_SOX=-0.25,0.25  # 異常值範圍（只標記、值記 null）：SOX／TSM 是單日對數報酬、VIX 是收盤值（預設 5,120）、NIGHT 是夜盤報酬（預設 -0.08,0.08）
